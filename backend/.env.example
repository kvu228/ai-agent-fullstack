# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every variable maps to a field of `Settings` in app/core/config.py (case-insensitive).

APP_NAME="Document Assistant API"
ENVIRONMENT=development          # development | staging | production | test
LOG_LEVEL=INFO

# JSON array (pydantic-settings parses list fields as JSON).
CORS_ORIGINS=["http://localhost:3000"]

# ---- PostgreSQL (docker compose -> localhost:5433; AWS RDS in production) ----
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app

# ---- Auth ----
# >= 32 chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Leave commented out in development to use the built-in dev secret (refused in production).
# JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false              # true in production (HTTPS only)

# ---- S3 (Floci locally; remove S3_ENDPOINT_URL to use real AWS) ----
S3_BUCKET=documents
S3_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
MAX_UPLOAD_MB=20

# ---- ChromaDB ----
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=documents

# ---- LLM & embeddings ("<provider>:<model>") ----
LLM_MODEL=anthropic:claude-sonnet-5-5
EMBEDDING_MODEL=openai:text-embedding-3-small
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- LangSmith tracing (optional; empty endpoint/project = LangSmith's default) ----
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
